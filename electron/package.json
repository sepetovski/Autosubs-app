{
  "name": "autosubs",
  "version": "1.0.0",
  "description": "AutoSubs App",
  "author": "sepetovski",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "ELECTRON_LOAD_DIST=true electron .",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.autosubs.app",
    "productName": "AutoSubs",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "runtime.js",
      "runtime.json"
    ],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*.py", "assets/**/*"] },
      { "from": "../frontend/dist", "to": "frontend-dist" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sepetovski",
        "repo": "Autosubs-app"
      }
    ]
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "tar": "7.5.22"
  }
}
